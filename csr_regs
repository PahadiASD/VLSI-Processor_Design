
`timescale 1ns/10ps

module csr_regs #(
    parameter ENABLE_C = 1
)(
    input wire clk,
    input wire a_reset_l,

    input wire [11:0] csr_addr,
    input wire [63:0] csr_wdata,
    input wire [1:0] csr_op,
    input wire csr_write_en,

    output reg [63:0] csr_rdata,

    input wire trap_mepc_we,
    input wire [63:0] trap_mepc,

    input wire trap_mcause_we,
    input wire [63:0] trap_mcause,

    output wire mstatus_mie,
    output wire [63:0] mepc_out,
    output wire [63:0] mcause_out,

    output reg csr_illegal
);

    localparam [11:0] CSR_MSTATUS = 12'h300;
    localparam [11:0] CSR_MISA    = 12'h301;
    localparam [11:0] CSR_MTVEC   = 12'h305;
    localparam [11:0] CSR_MEPC    = 12'h341;
    localparam [11:0] CSR_MCAUSE  = 12'h342;

    localparam [1:0] CSR_WRITE = 2'b00;
    localparam [1:0] CSR_SET   = 2'b01;
    localparam [1:0] CSR_CLEAR = 2'b10;

    // Writable CSR storages
    reg mstatus_mie_reg;
    reg [63:0] mepc_reg;
    reg [63:0] mcause_reg;

    wire [63:0] mstatus_cur =
        {60'b0, mstatus_mie_reg, 3'b0};

    wire [25:0] misa_ext_bits =
        (26'h1 << 8) |
        (26'h1 << 12) |
        (ENABLE_C ? (26'h1 << 2) : 26'h0);

    localparam [1:0] MISA_MXL_RV64 = 2'b10;

    wire [63:0] misa_value =
        {MISA_MXL_RV64, 36'b0, misa_ext_bits};

    localparam [63:0] MTVEC_VALUE =
        64'h0000000000000001;

    function [63:0] csr_next_value;
        input [63:0] cur;
        input [63:0] wdata;
        input [1:0] op;

        begin
            case (op)
                CSR_WRITE:
                    csr_next_value = wdata;

                CSR_SET:
                    csr_next_value = cur | wdata;

                CSR_CLEAR:
                    csr_next_value = cur & ~wdata;

                default:
                    csr_next_value = cur;
            endcase
        end
    endfunction

    wire [63:0] mstatus_next =
        csr_next_value(mstatus_cur, csr_wdata, csr_op);

    wire [63:0] mepc_next =
        csr_next_value(mepc_reg, csr_wdata, csr_op);

    wire [63:0] mcause_next =
        csr_next_value(mcause_reg, csr_wdata, csr_op);

    // Combinational read path + illegal access detection
    always @* begin
        csr_rdata = 64'h0;
        csr_illegal = 1'b0;

        case (csr_addr)
            CSR_MSTATUS:
                csr_rdata = mstatus_cur;

            CSR_MISA:
                csr_rdata = misa_value;

            CSR_MTVEC:
                csr_rdata = MTVEC_VALUE;

            CSR_MEPC:
                csr_rdata = mepc_reg;

            CSR_MCAUSE:
                csr_rdata = mcause_reg;

            default: begin
                csr_rdata = 64'h0;
                csr_illegal = 1'b1;
            end
        endcase

        if (csr_write_en &&
            ((csr_addr == CSR_MISA) ||
             (csr_addr == CSR_MTVEC)))
            csr_illegal = 1'b1;
    end

    // Sequential write path
    always @(posedge clk or negedge a_reset_l) begin
        if (!a_reset_l) begin
            mstatus_mie_reg <= 1'b0;
            mepc_reg <= 64'h0;
            mcause_reg <= 64'h0;
        end
        else begin
            if (trap_mepc_we)
                mepc_reg <= trap_mepc;
            else if (csr_write_en &&
                     (csr_addr == CSR_MEPC))
                mepc_reg <= mepc_next;

            if (trap_mcause_we)
                mcause_reg <= trap_mcause;
            else if (csr_write_en &&
                     (csr_addr == CSR_MCAUSE))
                mcause_reg <= mcause_next;

            if (csr_write_en &&
                (csr_addr == CSR_MSTATUS))
                mstatus_mie_reg <= mstatus_next[3];
        end
    end

    assign mstatus_mie = mstatus_mie_reg;
    assign mepc_out = mepc_reg;
    assign mcause_out = mcause_reg;

endmodule
