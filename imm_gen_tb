
`timescale 1ns/10ps

module tb_imm_gen;

    reg [31:0] instr;
    reg [2:0] imm_sel;
    wire [63:0] imm;

    localparam IMM_I = 3'b000;
    localparam IMM_S = 3'b001;
    localparam IMM_B = 3'b010;
    localparam IMM_U = 3'b011;
    localparam IMM_J = 3'b100;

    integer errors = 0;

    imm_gen imm_gen_i (
        .instr(instr),
        .imm_sel(imm_sel),
        .imm(imm)
    );

    task check_imm;
        input [63:0] expected;
        input [127:0] msg;
        begin
            #1;
            if (imm !== expected) begin
                $display("FAIL %0s: instr=0x%08h expected=0x%016h got=0x%016h",
                         msg, instr, expected, imm);
                errors = errors + 1;
            end else begin
                $display("PASS %0s: instr=0x%08h imm=0x%016h",
                         msg, instr, imm);
            end
        end
    endtask




endmodule
