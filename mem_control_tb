
`timescale 1ns/10ps

module tb_mem_control ();

    reg clk;
    reg a_reset_l;

    reg mem_access;
    reg mem_read;
    reg mem_write;
    reg [63:0] mem_addr;
    reg [63:0] store_data;
    reg [7:0] byte_en;
    reg [63:0] sram_rdata;
    reg sram_ready;
    reg [63:0] ext_rdata;
    reg ext_ready;

    wire [63:0] mem_rdata;
    wire mem_ready;
    wire mem_error;
    wire sram_req;
    wire sram_we;
    wire [11:0] sram_word_addr;
    wire [63:0] sram_wdata;
    wire [7:0] sram_byte_en;
    wire ext_req;
    wire ext_we;
    wire [16:0] ext_addr;
    wire [63:0] ext_wdata;
    wire [7:0] ext_byte_en;

    integer errors = 0;

    mem_control mem_control_i (
        .mem_access (mem_access),
        .mem_read (mem_read),
        .mem_write (mem_write),
        .mem_addr (mem_addr),
        .store_data (store_data),
        .byte_en (byte_en),
        .sram_rdata (sram_rdata),
        .sram_ready (sram_ready),
        .ext_rdata (ext_rdata),
        .ext_ready (ext_ready),
        .mem_rdata (mem_rdata),
        .mem_ready (mem_ready),
        .mem_error (mem_error),
        .sram_req (sram_req),
        .sram_we (sram_we),
        .sram_word_addr (sram_word_addr),
        .sram_wdata (sram_wdata),
        .sram_byte_en (sram_byte_en),
        .ext_req (ext_req),
        .ext_we (ext_we),
        .ext_addr (ext_addr),
        .ext_wdata (ext_wdata),
        .ext_byte_en (ext_byte_en)
    );

    task check1;
        input actual, expected;
        input [255:0] msg;
        begin
            #1;
            if (actual !== expected) begin
                $display("FAIL %0s: expected=%0d got=%0d",
                         msg, expected, actual);
                errors = errors + 1;
            end
            else
                $display("PASS %0s: value=%0d", msg, actual);
        end
    endtask

    task check64;
        input [63:0] actual, expected;
        input [255:0] msg;
        begin
            #1;
            if (actual !== expected) begin
                $display("FAIL %0s: expected=0x%016h got=0x%016h",
                         msg, expected, actual);
                errors = errors + 1;
            end
            else
                $display("PASS %0s: value=0x%016h", msg, actual);
        end
    endtask

    task check16;
        input [16:0] actual;
        input [16:0] expected;
        input [255:0] msg;
        begin
            #1;
            if (actual !== expected) begin
                $display("FAIL %0s: expected=0x%05h got=0x%05h",
                         msg, expected, actual);
                errors = errors + 1;
            end
            else
                $display("PASS %0s: value=0x%05h", msg, actual);
        end
    endtask

    task check12;
        input [11:0] actual;
        input [11:0] expected;
        input [255:0] msg;
        begin
            #1;
            if (actual !== expected) begin
                $display("FAIL %0s: expected=0x%03h got=0x%03h",
                         msg, expected, actual);
                errors = errors + 1;
            end
            else
                $display("PASS %0s: value=0x%03h", msg, actual);
        end
    endtask

    ////////////////////////////////////////////
    //// Template for clk and reset generation
    //// uncomment it when needed
    ////////////////////////////////////////////

    parameter CLKPERIOD = 100;

    initial clk = 1'b1;
    always #(CLKPERIOD/2.0) clk = !clk;

    initial begin
        a_reset_l = 1'b0;
        #33
        a_reset_l = 1'b1;
    end

    ////////////////////////////////////////////

    // Template for testcase specific pattern generation
    // File has to be situated in simulation/<simulator_name>/<testcase> directory
    `include "testcase.v"

endmodule
