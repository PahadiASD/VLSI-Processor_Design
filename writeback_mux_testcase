 * Project: RISC-V Core
 * Description: Writeback MUX Test Cases
 */

// Fill in testcase specific pattern generation
initial begin
    alu_result    = 64'h1111111111111111;
    muldiv_result = 64'h2222222222222222;
    load_result   = 64'h3333333333333333;
    pc_return     = 64'h4444444444444444;
    csr_result    = 64'h5555555555555555;
    wb_sel = WB_ALU;
    #1;

    // select ALU result
    wb_sel = WB_ALU;
    check_wb(64'h1111111111111111, "WB_ALU selects alu_result");

    // select mul/div result
    wb_sel = WB_MULDIV;
    check_wb(64'h2222222222222222, "WB_MULDIV selects muldiv_result");

    // select load result
    wb_sel = WB_LOAD;
    check_wb(64'h3333333333333333, "WB_LOAD selects load_result");

    // select pc return value
    wb_sel = WB_PC;
    check_wb(64'h4444444444444444, "WB_PC selects pc_return");

    // select csr result
    wb_sel = WB_CSR;
    check_wb(64'h5555555555555555, "WB_CSR selects csr_result");

    // unsupported selection -> default zero
    wb_sel = WB_UNUSED;
    check_wb(64'h0000000000000000, "unsupported wb_sel gives zero");

    // change ALU inputs and check propagation
    alu_result = 64'hDEADBEEFCAFEBABE;
    wb_sel = WB_ALU;
    check_wb(64'hDEADBEEFCAFEBABE, "WB_ALU updated value");

    // change MUL/DIV input
    muldiv_result = 64'h0123456789ABCDEF;
    wb_sel = WB_MULDIV;
    check_wb(64'h0123456789ABCDEF, "WB_MULDIV updated value");

    // change LOAD input
    load_result = 64'hFFFFFFFF00000000;
    wb_sel = WB_LOAD;
    check_wb(64'hFFFFFFFF00000000, "WB_LOAD updated value");

    // check zero value through selected source
    csr_result = 64'h0000000000000000;
    wb_sel = WB_CSR;
    check_wb(64'h0000000000000000, "WB_CSR selects zero correctly");

    if (errors == 0)
        $display("\n*** ALL TESTS PASSED ***\n");
    else
        $display("\n*** %0d TEST(S) FAILED ***\n", errors);

    $finish();
end
