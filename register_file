
`timescale 1ns/10ps

module register_file (
    input wire clk,

    input wire [4:0] rs1_addr,
    input wire [4:0] rs2_addr,
    output wire [63:0] rs1_data,
    output wire [63:0] rs2_data,

    input wire [4:0] rd_addr,
    input wire [63:0] rd_data,
    input wire rd_write
);

    // 32 general purpose registers x0 to x31, 64 bits each
    // x0 is never actually used as storage

    reg [63:0] registers [0:31];

    // Combinational (asynchronous) read ports
    // x0 always reads as zero, regardless of what is stored at registers[0]

    assign rs1_data = (rs1_addr == 5'd0) ? 64'h0 : registers[rs1_addr];
    assign rs2_data = (rs2_addr == 5'd0) ? 64'h0 : registers[rs2_addr];

    // Synchronous write port

    always @(posedge clk) begin
        if (rd_write && (rd_addr != 5'd0)) begin
            registers[rd_addr] <= rd_data;
        end
    end

endmodule
