
`timescale 1ns/10ps

module imm_gen (
    input wire [31:0] instr,
    input wire [2:0] imm_sel,
    output reg [63:0] imm
);

    localparam IMM_I = 3'b000;
    localparam IMM_S = 3'b001;
    localparam IMM_B = 3'b010;
    localparam IMM_U = 3'b011;
    localparam IMM_J = 3'b100;

    always @(*) begin
        case (imm_sel)

            // I type: instr [31:20], sign extended
            IMM_I: imm = {{52{instr[31]}}, instr[31:20]};

            // S type: instr [31:25], instr[11:7], sign extended
            IMM_S: imm = {{52{instr[31]}}, instr[31:25], instr[11:7]};

            // B type: instr[31]/ instr[7]/ instr[30:25]/ instr[11:8]/ 0, sign extended
            IMM_B: imm = {{51{instr[31]}}, instr[31], instr[7], instr[30:25], instr[11:8], 1'b0};

            // U type: {instr[31:12], 12'b0}, sign extended to XLEN=64
            IMM_U: imm = {{32{instr[31]}}, instr[31:12], 12'b0};

            // J type: instr[31]/ instr[19:12]/ instr[20]/ instr[30:21]/0, sign extended
            IMM_J: imm = {{43{instr[31]}}, instr[31], instr[19:12], instr[20], instr[30:21], 1'b0};

            // default: drive to zero for any undefined imm_sel to avoid inferring a latch
            default: imm = 64'h0;

        endcase
    end

endmodule
