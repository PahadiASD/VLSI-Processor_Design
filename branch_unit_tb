
`timescale 1ns/10ps

module tb_branch_unit ();

    reg clk;
    reg a_reset_l;

    reg [63:0] rs1_data, rs2_data;
    reg [2:0] branch_op;
    wire branch_taken;

    localparam BR_BEQ  = 3'b000;
    localparam BR_BNE  = 3'b001;
    localparam BR_BLT  = 3'b010;
    localparam BR_BGE  = 3'b011;
    localparam BR_BLTU = 3'b100;
    localparam BR_BGEU = 3'b101;

    integer errors = 0;

    branch_unit branch_unit_i (
        .rs1_data (rs1_data),
        .rs2_data (rs2_data),
        .branch_op (branch_op),
        .branch_taken (branch_taken)
    );

    task check_taken;
        input expected;
        input [127:0] msg;
        begin
            #1;
            if (branch_taken !== expected) begin
                $display("FAIL %0s: rs1=0x%016h rs2=0x%016h expected=%0d got=%0d",
                         msg, rs1_data, rs2_data, expected, branch_taken);
                errors = errors+1;
            end else begin
                $display("PASS %0s: branch_taken=%0d", msg, branch_taken);
            end
        end
    endtask

    ///////////////////////////////////////////////
    // Template for clk and reset generation
    // uncomment it when needed
    ///////////////////////////////////////////////

    parameter CLKPERIOD = 100;

    initial clk = 1'b1;
    always #(CLKPERIOD/2.0) clk = !clk;

    //initial begin
    //    a_reset_l = 1'b0;
    //    #33
    //    a_reset_l = 1'b1;
    //end

    ///////////////////////////////////////////////
    // Template for testcase specific pattern generation
    // File has to be situated in simulation/<simulator_name>/[testcase] directory
    `include "testcase.v"

endmodule
