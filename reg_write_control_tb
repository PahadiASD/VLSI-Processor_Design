
`timescale 1ns/10ps

module tb_reg_write_control (
);

    reg decoded_reg_write;
    reg [4:0] rd_addr;
    reg instruction_valid;
    reg instruction_commit;
    reg illegal_instr;
    reg exception_pending;
    reg flush;

    wire final_reg_write_en;
    integer total_tests = 0;
    integer passed_tests = 0;
    integer failed_tests = 0;


    reg_write_control reg_write_control_i (
        .decoded_reg_write (decoded_reg_write ),
        .rd_addr (rd_addr ),
        .instruction_valid (instruction_valid ),
        .instruction_commit (instruction_commit ),
        .illegal_instr (illegal_instr ),
        .exception_pending (exception_pending ),
        .flush (flush ),
        .final_reg_write_en (final_reg_write_en )
    );

    task run_check;
        input exp_we;
        input [255:0] test_name;
        begin
            total_tests = total_tests+1;
            #1;
            if (final_reg_write_en === exp_we) begin
                passed_tests = passed_tests+1;
                $display ("TEST %0d: PASS (%0s)", total_tests, test_name);
            end else begin
                failed_tests = failed_tests+1;
                $display ("TEST %0d: FAIL (%0s)", total_tests, test_name);
                $display ("expected: final_reg_write_en=%0d", exp_we );
                $display ("actual: final_reg_write_en=%0d", final_reg_write_en);
            end
        end
    endtask

    task set_defaults;
        begin
            decoded_reg_write = 1'b0;
            rd_addr = 5'd0;
            instruction_valid = 1'b0;
            instruction_commit = 1'b0;
            illegal_instr = 1'b0;
            exception_pending = 1'b0;
            flush = 1'b0;
        end
    endtask

