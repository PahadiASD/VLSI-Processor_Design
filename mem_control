
`timescale 1ns/10ps

module mem_control (
    // CPU/LSU side
    input wire mem_access,
    input wire mem_read,
    input wire mem_write,
    input wire [63:0] mem_addr,
    input wire [63:0] store_data,
    input wire [7:0] byte_en,

    output reg [63:0] mem_rdata,
    output reg mem_ready,
    output reg mem_error,

    // Internal SRAM side
    output reg sram_req,
    output reg sram_we,
    output reg [11:0] sram_word_addr,
    output reg [63:0] sram_wdata,
    output reg [7:0] sram_byte_en,

    input wire [63:0] sram_rdata,
    input wire sram_ready,

    // External memory side
    output reg ext_req,
    output reg ext_we,
    output reg [16:0] ext_addr,
    output reg [63:0] ext_wdata,
    output reg [7:0] ext_byte_en,

    input wire [63:0] ext_rdata,
    input wire ext_ready
);

    // Kreacher memory map only distinguishes addresses up to bit 17
    wire [17:0] local_addr = mem_addr[17:0];

    // Internal SRAM occupies ...
    wire select_internal = (local_addr[17:15] == 3'b000);

    // External address remapping:
    // Dropping bit 17 handles both external regions with one expression
    wire [17:0] ext_addr_mapped = local_addr[16:0];

    // Internal SRAM word index
    wire [17:0] sram_word_addr_calc = local_addr[14:3];

    // A request that asks to read and write simultaneously is invalid
    wire req_conflict = mem_read && mem_write;

    always @* begin
        sram_req = 1'b0;
        sram_we = 1'b0;
        sram_word_addr = 12'h0;
        sram_wdata = 64'h0;
        sram_byte_en = 8'h0;

        ext_req = 1'b0;
        ext_we = 1'b0;
        ext_addr = 17'h0;
        ext_wdata = 64'h0;
        ext_byte_en = 8'h0;

        mem_rdata = 64'h0;
        mem_ready = 1'b0;
        mem_error = 1'b0;

        if (mem_access) begin
            if (req_conflict) begin
                mem_error = 1'b1;
            end
            else if (select_internal) begin
                sram_req = 1'b1;

                sram_we = mem_write;
                sram_word_addr = sram_word_addr_calc;
                sram_wdata = store_data;
                sram_byte_en = byte_en;

                mem_rdata = sram_rdata;
                mem_ready = sram_ready;
            end
            else begin
                ext_req = 1'b1;
                ext_we = mem_write;
                ext_addr = ext_addr_mapped;
                ext_wdata = store_data;
                ext_byte_en = byte_en;

                mem_rdata = ext_rdata;
                mem_ready = ext_ready;
            end
        end
    end

endmodule
